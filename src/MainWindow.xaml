<Window x:Class="QTPresetManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        Title="Quantower Preset Manager"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        Foreground="#cccccc">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Quantower Preset Manager"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#007acc"
                   Margin="0,0,0,20"/>

        <TabControl Grid.Row="1" Margin="0,0,0,16">
            <TabItem Header="Presets">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="btnSavePreset" Content="Save Preset" Width="140" Height="32" Click="BtnSavePreset_Click"/>
                        <Button Grid.Column="1" x:Name="btnApplyPreset" Content="Apply Preset" Width="140" Height="32" Margin="0,0,8,0" Click="BtnApplyPreset_Click"/>
                        <Button Grid.Column="2" x:Name="btnDeletePreset" Content="Delete Preset" Width="140" Height="32" Click="BtnDeletePreset_Click"/>
                    </Grid>
                    <TextBox x:Name="txtPresetName" Width="260" Margin="0,8,0,8"/>
                    <ListBox x:Name="lstPresets" Height="360" Foreground="#cccccc" DisplayMemberPath="Name"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Settings">
                <StackPanel>
                    <TextBlock Text="Quantower Config Path:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtConfigPath" Width="400" Margin="0,0,0,8"/>
                    <TextBlock Text="Preset Folder Path:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtPresetFolder" Width="400" Margin="0,0,0,8"/>
                    <CheckBox x:Name="chkBackupEnabled" Content="Enable backup" Margin="0,8,0,8"/>
                    <Button x:Name="btnSaveSettings" Content="Save Settings" Width="140" Height="32" Click="BtnSaveSettings_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Margin="0,20,0,0" Background="#2d2d2d" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Foreground="#888888" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
